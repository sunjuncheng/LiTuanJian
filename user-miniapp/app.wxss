page {
  background-color: #F5F6F8;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  font-size: 28rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 71, 87, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-outline {
  background-color: #fff;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 0;
}

.btn-outline::after {
  border: none;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-primary {
  color: #FF6B35;
}

.text-success {
  color: #6BCB77;
}

.text-warning {
  color: #FFB800;
}

.text-danger {
  color: #FF4757;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-blue {
  background: #E8F4FD;
  color: #4A90D9;
}

.tag-green {
  background: #E8F8EE;
  color: #6BCB77;
}

.tag-orange {
  background: #FFF3E0;
  color: #FF6B35;
}

.tag-red {
  background: #FFF1F0;
  color: #FF4757;
}

.tag-gray {
  background: #F0F0F0;
  color: #999;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}
