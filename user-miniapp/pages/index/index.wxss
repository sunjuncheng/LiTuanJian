.header {
  padding: 20rpx 0 10rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin: 20rpx 0;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.tab-active {
  background: #4A90D9;
  color: #fff;
  font-weight: bold;
}

.task-list {
  margin-top: 10rpx;
}

.task-card {
  margin-bottom: 20rpx;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  white-space: nowrap;
}

.tag-green {
  background: #52c41a;
}

.tag-blue {
  background: #4A90D9;
}

.tag-gray {
  background: #999;
}

.tag-red {
  background: #ff4d4f;
}

.tag-orange {
  background: #fa8c16;
}

.mode-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}

.task-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.task-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #888;
}

.progress-section {
  margin-bottom: 16rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.progress-text {
  color: #4A90D9;
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #52c41a;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.text-muted {
  font-size: 24rpx;
  color: #999;
}

.text-primary {
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: bold;
}

.text-success {
  font-size: 26rpx;
  color: #52c41a;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty .btn-primary {
  margin-top: 30rpx;
  width: 200rpx;
}

.btn-primary {
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 16rpx 0;
  border: none;
}

.btn-primary::after {
  border: none;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
