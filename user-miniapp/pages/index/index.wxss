.header {
  padding: 10rpx 0 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 0;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.25s;
  font-weight: 500;
}

.tab-active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.3);
}

.task-list {
  margin-top: 10rpx;
}

.task-card {
  overflow: hidden;
  padding: 0;
}

.task-cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.6) 100%);
}

.task-name-overlay {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  right: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.task-body {
  padding: 24rpx;
}

.mode-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.task-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.task-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.task-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 4rpx;
}

.status-badge {
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-badge.success {
  background: #E8F8EE;
  color: #6BCB77;
}

.status-badge.primary {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
}

.progress-section {
  margin-bottom: 12rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
}

.progress-text {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 700;
}

.progress-bar {
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF4757);
  border-radius: 7rpx;
  transition: width 0.3s;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.empty .btn-primary {
  margin-top: 30rpx;
  width: 240rpx;
  display: inline-block;
}

.sub-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.sub-tab.active {
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  color: #fff;
  font-weight: 600;
}

.task-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 10rpx 32rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
}

.cancel-btn {
  color: #999;
  border: 1rpx solid #ddd;
}
