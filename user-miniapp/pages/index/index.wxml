<view class="container">
  <view class="header">
    <text class="title">🏃 团建打卡任务</text>
    <text class="subtitle">挑战自我，团队协作</text>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'all' ? 'tab-active' : ''}}" data-tab="all" bindtap="switchTab">
      全部任务
    </view>
    <view class="tab-item {{currentTab === 'my' ? 'tab-active' : ''}}" data-tab="my" bindtap="switchTab">
      我的任务
    </view>
  </view>

  <view wx:if="{{currentTab === 'all'}}">
    <view wx:if="{{allTasks.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">📋</view>
      <text>暂无进行中的任务</text>
    </view>

    <view class="task-list">
      <view
        class="task-card card"
        wx:for="{{allTasks}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="task-cover">
          <image class="cover-img" src="{{item.coverImage || defaultCover}}" mode="aspectFill"></image>
          <view class="cover-mask"></view>
          <view class="task-name-overlay">{{item.name}}</view>
        </view>
        <view class="task-body">
          <view class="mode-tags">
            <text class="tag tag-orange" wx:if="{{item.acceptMode === 1 || item.acceptMode === 3}}">单人可接</text>
            <text class="tag tag-green" wx:if="{{item.acceptMode === 2 || item.acceptMode === 3}}">团队可接</text>
            <text class="tag tag-gray" wx:if="{{item.statusText !== '进行中'}}">{{item.statusText}}</text>
            <text class="tag tag-green" wx:else>进行中</text>
          </view>
          <view class="task-desc">{{item.description}}</view>
          <view class="task-meta">
            <text class="meta-item">📍 {{item.checkpointCount}} 个打卡点</text>
            <text class="meta-item">👥 {{item.participantCount}} 人参与</text>
          </view>
          <view class="task-meta" wx:if="{{item.deadlineText}}">
            <text class="meta-item">⏰ 截止 {{item.deadlineText}}</text>
          </view>
          <view class="task-footer">
            <text wx:if="{{item.accepted}}" class="status-badge success">已接单</text>
            <text wx:elif="{{item.canAccept}}" class="status-badge primary">可接单 →</text>
            <text wx:elif="{{item.isEnded}}" class="text-muted">已过时</text>
            <text wx:else class="text-muted">已结束</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{currentTab === 'my'}}">
    <view wx:if="{{!isLoggedIn}}" class="empty">
      <view class="empty-icon">🔒</view>
      <text>请先登录查看我的任务</text>
      <button class="btn-primary" bindtap="goLogin">去登录</button>
    </view>

    <block wx:else>
      <view class="sub-tabs">
        <view class="sub-tab {{myTaskFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="switchMyTaskFilter">全部</view>
        <view class="sub-tab {{myTaskFilter === 'solo' ? 'active' : ''}}" data-filter="solo" bindtap="switchMyTaskFilter">个人任务</view>
        <view class="sub-tab {{myTaskFilter === 'team' ? 'active' : ''}}" data-filter="team" bindtap="switchMyTaskFilter">团队任务</view>
      </view>

      <view wx:if="{{filteredMyTasks.length === 0 && !loading}}" class="empty">
        <view class="empty-icon">🎯</view>
        <text>暂无任务</text>
      </view>

      <view class="task-list">
        <view
          class="task-card card"
          wx:for="{{filteredMyTasks}}"
          wx:key="taskId"
          data-id="{{item.taskId}}"
          bindtap="goMyTaskDetail"
        >
        <view class="task-cover">
          <image class="cover-img" src="{{item.coverImage || defaultCover}}" mode="aspectFill"></image>
          <view class="cover-mask"></view>
          <view class="task-name-overlay">{{item.name}}</view>
        </view>
        <view class="task-body">
          <view class="mode-tags">
            <text class="tag {{item.participantType === 'solo' ? 'tag-orange' : 'tag-green'}}">
              {{item.participantTypeText}}接单
            </text>
            <text class="tag tag-gray" wx:if="{{!item.unlocked}}">未解锁</text>
            <text class="tag tag-green" wx:else>已解锁</text>
            <text class="tag {{item.statusText === '已完成' ? 'tag-green' : (item.statusText === '已逾期' ? 'tag-red' : 'tag-blue')}}">
              {{item.statusText}}
            </text>
          </view>
          <view class="progress-section">
            <view class="progress-info">
              <text class="progress-label">完成进度</text>
              <text class="progress-text">{{item.percentage}}% ({{item.passedCount}}/{{item.totalCheckpoints}})</text>
            </view>
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.percentage}}%"></view>
            </view>
          </view>
          <view class="task-meta" wx:if="{{item.deadlineText}}">
            <text class="meta-item">⏰ 截止 {{item.deadlineText}}</text>
          </view>
          <view class="task-actions" wx:if="{{item.statusText === '进行中' && !item.unlocked}}">
            <view
              class="action-btn cancel-btn"
              wx:if="{{item.participantType === 'solo'}}"
              data-id="{{item.taskId}}"
              catchtap="cancelTask"
            >放弃任务</view>
          </view>
        </view>
      </view>
    </view>
    </block>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
