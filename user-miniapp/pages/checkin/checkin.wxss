.checkpoint-tabs {
  margin-bottom: 20rpx;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.3);
}

.tab-item.active .tab-num {
  color: #fff;
}

.tab-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
}

.tab-status {
  font-size: 18rpx;
  color: #52c41a;
}

.tab-status.reviewing {
  color: #fa8c16;
}

.cp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cp-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.cp-location {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.map-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.map-view {
  width: 100%;
  height: 360rpx;
}

.map-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 20rpx 24rpx;
}

.mini-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8A4C 100%);
  color: #fff;
}

.mini-btn::after {
  border: none;
}

.mini-btn-outline {
  background: #fff3ee;
  color: #FF6B35;
}

.distance-info {
  text-align: center;
  padding: 0 0 24rpx;
}

.distance-value {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
}

.distance-value.success {
  color: #34C759;
}

.distance-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF4757;
}

.section-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.reference-section {
  margin-bottom: 24rpx;
}

.reference-img {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.reference-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.photo-section {
  margin-bottom: 24rpx;
}

.photo-upload {
  width: 100%;
  height: 360rpx;
  background: #F8F9FB;
  border: 2rpx dashed #FF6B35;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 500;
}

.uploaded-photo {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.remark-section {
  margin-bottom: 20rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background: #F8F9FB;
  border-radius: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.reject-reason {
  padding: 16rpx;
  background: #FFF1EC;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.reject-label {
  font-size: 24rpx;
  color: #FF4757;
  font-weight: bold;
}

.reject-text {
  font-size: 24rpx;
  color: #FF4757;
}

.submit-bar {
  margin-top: 30rpx;
  padding: 0 24rpx 40rpx;
}
