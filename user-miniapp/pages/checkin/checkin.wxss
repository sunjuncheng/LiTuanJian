.checkpoint-tabs {
  margin-bottom: 20rpx;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
}

.tab-item.active {
  background: #4A90D9;
  border-color: #4A90D9;
}

.tab-item.active .tab-num {
  color: #fff;
}

.tab-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
}

.tab-status {
  font-size: 18rpx;
  color: #52c41a;
}

.tab-status.reviewing {
  color: #fa8c16;
}

.cp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cp-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.cp-location {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.reference-section {
  margin-bottom: 24rpx;
}

.reference-img {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.reference-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.photo-section {
  margin-bottom: 24rpx;
}

.photo-upload {
  width: 100%;
  height: 360rpx;
  background: #f8f9fa;
  border: 2rpx dashed #d0d0d0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.uploaded-photo {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.remark-section {
  margin-bottom: 20rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.reject-reason {
  padding: 16rpx;
  background: #fff1f0;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.reject-label {
  font-size: 24rpx;
  color: #f5222d;
  font-weight: bold;
}

.reject-text {
  font-size: 24rpx;
  color: #f5222d;
}

.submit-bar {
  margin-top: 30rpx;
  padding: 0 24rpx 40rpx;
}
