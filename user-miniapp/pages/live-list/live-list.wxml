<view class="container">
  <view class="hero card" wx:if="{{current}}" bindtap="openCurrentLive">
    <view class="hero-main">
      <text class="hero-badge">正在直播</text>
      <text class="hero-title">{{current.title}}</text>
      <text class="hero-desc">{{current.anchorName}} · {{current.startedText || '刚刚开播'}}</text>
    </view>
    <text class="hero-action">立即观看 ></text>
  </view>

  <view class="loading" wx:if="{{loading}}">直播列表加载中...</view>

  <view class="list" wx:elif="{{list.length}}">
    <view class="live-card card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openLive">
      <view class="live-head">
        <view class="live-meta">
          <text class="live-title">{{item.title}}</text>
          <text class="live-anchor">{{item.anchorName}}</text>
        </view>
        <text class="tag {{item.status === 'live' ? 'tag-red' : item.status === 'ended' ? 'tag-gray' : 'tag-orange'}}">{{item.statusText}}</text>
      </view>
      <text class="live-desc">{{item.description || '本场直播暂未填写简介，进入页面即可查看直播详情。'}}</text>
      <view class="live-footer">
        <text class="live-time">{{item.status === 'live' ? ('开播于 ' + (item.startedText || '刚刚')) : ('创建于 ' + item.createdText)}}</text>
        <text class="live-action">{{item.status === 'live' ? '进入直播间 >' : '查看详情 >'}}</text>
      </view>
    </view>
  </view>

  <view class="empty card" wx:else>
    <text class="empty-title">当前暂无直播安排</text>
    <text class="empty-desc">后台创建并开播后，这里会展示直播列表与观看入口。</text>
  </view>
</view>
