.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #ff6b35 0%, #ff4757 100%);
  color: #fff;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-desc,
.hero-action {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.hero-action {
  margin-left: 20rpx;
  white-space: nowrap;
  font-weight: 600;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.live-card {
  margin-bottom: 0;
}

.live-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.live-meta {
  flex: 1;
  min-width: 0;
}

.live-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.live-anchor {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

.live-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.live-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f3f3f3;
}

.live-time {
  font-size: 23rpx;
  color: #999;
}

.live-action {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 600;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.7;
}
