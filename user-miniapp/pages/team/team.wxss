.no-team {
  text-align: center;
  padding-top: 120rpx;
}

.empty-tip {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.team-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 40rpx;
}

.team-info {
  margin-top: 20rpx;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.team-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.invite-section {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.invite-label {
  font-size: 26rpx;
  color: #666;
}

.invite-code {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A90D9;
  letter-spacing: 4rpx;
  margin: 0 20rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #4A90D9;
  padding: 4rpx 16rpx;
  border: 1rpx solid #4A90D9;
  border-radius: 8rpx;
}

.member-count {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 45%;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.member-name {
  font-size: 26rpx;
  color: #333;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
