.no-team {
  text-align: center;
  padding: 120rpx 40rpx;
}

.team-actions {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.team-info {
  padding: 36rpx;
}

.team-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.team-avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.team-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.team-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.team-leader {
  font-size: 24rpx;
  color: #999;
}

.member-count-badge {
  background: #FFF1EC;
  color: #FF6B35;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.invite-section {
  background: #F8F9FB;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.invite-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.invite-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-code {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF6B35;
  letter-spacing: 8rpx;
}

.copy-btn {
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 24rpx;
}

.invite-tip {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.chat-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(255, 71, 87, 0.08));
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.chat-entry-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.chat-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.chat-entry-sub {
  font-size: 22rpx;
  color: #888;
}

.chat-entry-arrow {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
}

.member-section {
  margin-bottom: 32rpx;
}

.member-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  background: #F8F9FB;
  border-radius: 16rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.member-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.member-role {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF1EC;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.leader-badge {
  font-size: 32rpx;
}

.remove-btn {
  font-size: 24rpx;
  color: #FF4757;
  padding: 8rpx 20rpx;
  border: 1rpx solid #FF4757;
  border-radius: 24rpx;
}

.team-footer {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 24rpx;
}
