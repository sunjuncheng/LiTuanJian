<view class="container">
  <view wx:if="{{records.length === 0 && !loading}}" class="empty">
    <image class="records-illustration" src="{{recordsIllustration}}" mode="widthFix"></image>
    <text>暂无完成记录</text>
    <text class="empty-sub">完成任务后会显示在这里</text>
  </view>

  <view class="record-list" wx:else>
    <view
      class="record-card card"
      wx:for="{{records}}"
      wx:key="taskId"
      data-id="{{item.taskId}}"
      bindtap="goDetail"
    >
      <view class="record-cover">
        <image class="cover-img" src="{{item.coverImage || defaultCover}}" mode="aspectFill"></image>
        <view class="cover-mask"></view>
        <view class="record-name">{{item.name}}</view>
      </view>
      <view class="record-body">
        <view class="record-tags">
          <text class="tag tag-green">已完成</text>
          <text class="tag {{item.participantType === 'solo' ? 'tag-orange' : 'tag-green'}}">
            {{item.participantTypeText}}
          </text>
        </view>
        <view class="record-meta">
          <view class="meta-item">
            <image class="meta-icon" src="{{icons.success}}" mode="aspectFit"></image>
            <text>完成度 {{item.percentage}}%</text>
          </view>
          <view class="meta-item">
            <image class="meta-icon" src="{{icons.location}}" mode="aspectFit"></image>
            <text>{{item.passedCount}}/{{item.totalCheckpoints}} 打卡点</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
