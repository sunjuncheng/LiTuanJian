<view class="container" wx:if="{{task}}">
  <view class="point-card card">
    <view class="point-icon">📍</view>
    <view class="point-name">{{task.startPoint.name}}</view>
    <view class="point-desc">请前往此地点，上传实时位置以解锁打卡任务</view>
    <view class="range-tip">允许误差范围：{{task.startPoint.range}} 米</view>
  </view>

  <view class="map-card card">
    <map
      wx:if="{{hasValidStartPoint}}"
      class="map-view"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      scale="{{mapScale}}"
      markers="{{markers}}"
      circles="{{circles}}"
      include-points="{{includePoints}}"
      show-location
      enable-zoom
      enable-scroll
    ></map>
    <view wx:else class="map-empty">暂未配置启动点坐标</view>
    <view class="map-actions" wx:if="{{hasValidStartPoint}}">
      <button class="mini-btn" bindtap="openStartPointLocation">查看起点位置</button>
      <button class="mini-btn mini-btn-outline" bindtap="moveToMyLocation">回到我的位置</button>
    </view>
  </view>

  <view class="distance-info card" wx:if="{{currentLocation}}">
    <view class="distance-value" wx:if="{{!inRange}}">
      距起点约 <text class="distance-num">{{distance}}</text> 米
    </view>
    <view class="distance-value success" wx:if="{{inRange}}">
      ✅ 已在起点范围内
    </view>
  </view>

  <view class="action-area" wx:if="{{!unlocked && !task.isEnded}}">
    <button
      class="btn-primary"
      bindtap="checkLocation"
      loading="{{checking}}"
      disabled="{{checking}}"
    >
      {{checking ? '定位中...' : '上传我的实时位置'}}
    </button>
    <view class="tip">需到达启动点位后上传定位，匹配成功即可解锁全部打卡任务</view>
  </view>

  <view class="action-area" wx:if="{{unlocked && !task.isEnded}}">
    <button class="btn-primary" bindtap="goCheckin">开始打卡</button>
  </view>

  <view class="action-area" wx:if="{{task.isEnded}}">
    <view class="ended-tip">任务已过时，无法继续操作</view>
  </view>
</view>
