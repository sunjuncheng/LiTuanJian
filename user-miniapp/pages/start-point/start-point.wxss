.point-card {
  text-align: center;
  padding: 50rpx 24rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
}

.point-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.point-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.point-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.range-tip {
  font-size: 24rpx;
  opacity: 0.8;
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

.map-card {
  overflow: hidden;
  padding: 0;
}

.map-view {
  width: 100%;
  height: 420rpx;
}

.map-empty {
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 26rpx;
  background: #F8F9FB;
  border: 2rpx dashed #e0e0e0;
}

.map-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  background: #fff;
}

.mini-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8A4C 100%);
  color: #fff;
}

.mini-btn::after {
  border: none;
}

.mini-btn-outline {
  background: #fff3ee;
  color: #FF6B35;
}

.distance-info {
  text-align: center;
  padding: 30rpx;
}

.distance-value {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: 500;
}

.distance-value.success {
  color: #6BCB77;
  font-weight: 700;
}

.distance-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF4757;
}

.action-area {
  margin-top: 40rpx;
  padding: 0 24rpx;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  line-height: 1.5;
}
