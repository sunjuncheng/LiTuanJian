<view class="container">
  <view class="profile-card card" wx:if="{{userInfo}}">
    <view class="profile-row" bindtap="goProfileEdit">
      <text class="profile-label">个人昵称</text>
      <text class="profile-value">{{userInfo.nickname || '去设置'}}</text>
      <text class="menu-arrow">></text>
    </view>
    <view wx:if="{{userInfo.hasPhone}}" class="profile-row">
      <text class="profile-label">手机号</text>
      <text class="profile-value">{{userInfo.phone}}</text>
    </view>
    <view wx:else class="profile-row" bindtap="goBindPhone">
      <text class="profile-label">手机号</text>
      <text class="profile-value profile-link">去绑定</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-list card">
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="about">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="logout-area">
    <button class="btn-outline" bindtap="logout">退出登录</button>
  </view>
</view>
