.profile-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.profile-row:last-child {
  border-bottom: none;
}

.profile-label {
  font-size: 28rpx;
  color: #333;
}

.profile-value {
  flex: 1;
  text-align: right;
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.profile-link {
  color: #FF6B35;
}

.menu-list {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-icon-image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-area {
  margin-top: 60rpx;
  padding: 0 24rpx;
}
