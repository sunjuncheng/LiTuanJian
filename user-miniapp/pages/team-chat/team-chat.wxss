.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 30rpx;
}

.chat-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.team-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.team-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.team-status {
  font-size: 22rpx;
  color: #999;
}

.member-count {
  font-size: 24rpx;
  color: #FF6B35;
  background: #FFF1EC;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 20rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.message-item.self {
  justify-content: flex-end;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F3F4F6;
}

.message-main {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.message-item.self .message-main {
  align-items: flex-end;
}

.sender-name {
  font-size: 22rpx;
  color: #999;
}

.message-bubble {
  background: #fff;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  padding: 20rpx 24rpx;
  color: #333;
  line-height: 1.6;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  word-break: break-all;
}

.message-item.self .message-bubble {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}

.message-time {
  font-size: 20rpx;
  color: #B3B3B3;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.08);
}

.chat-input {
  flex: 1;
  min-height: 44rpx;
  font-size: 28rpx;
}

.send-btn {
  margin: 0;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn::after {
  border: none;
}
