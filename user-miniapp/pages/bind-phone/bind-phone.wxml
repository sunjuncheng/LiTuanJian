<view class="container">
  <view class="intro card">
    <text class="intro-title">完善账号信息</text>
    <text class="intro-desc">绑定手机号并设置登录密码后，你可以更方便地登录账号、找回账号，并接收重要通知。</text>
  </view>

  <view class="form-section card">
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入常用手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-row">
      <text class="form-label">登录密码</text>
      <input class="form-input" password maxlength="20" placeholder="请设置 6 位以上密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="form-row">
      <text class="form-label">确认密码</text>
      <input class="form-input" password maxlength="20" placeholder="请再次输入登录密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
    </view>
  </view>

  <view class="save-area">
    <button class="btn-primary" bindtap="submit" loading="{{saving}}" disabled="{{saving}}">确认并完成</button>
  </view>
</view>
