<view class="container">
  <view class="avatar-section card">
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image class="avatar" src="{{avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
      <view class="avatar-edit">📷</view>
    </view>
    <text class="avatar-tip">点击更换头像</text>
  </view>

  <view class="form-section card">
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
    </view>
    <view class="form-row" bindtap="goChangePassword">
      <text class="form-label">修改密码</text>
      <text class="form-arrow">›</text>
    </view>
  </view>

  <view class="save-area">
    <button class="btn-primary" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}">保存</button>
  </view>
</view>
