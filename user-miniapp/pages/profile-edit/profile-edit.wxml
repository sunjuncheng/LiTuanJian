<view class="container">
  <view class="avatar-section card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <view class="avatar-wrap">
        <image class="avatar" src="{{avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
        <view class="avatar-edit">📷</view>
      </view>
    </button>
    <view class="avatar-actions">
      <text class="avatar-tip">点击同步微信头像</text>
      <text class="avatar-subtip" bindtap="chooseAvatar">或从相册、拍照中选择一张头像</text>
    </view>
  </view>

  <view class="form-section card">
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input class="form-input" type="nickname" placeholder="支持一键填写微信昵称，也可手动修改" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
    </view>
    <view wx:if="{{userInfo.hasPhone}}" class="form-row">
      <text class="form-label">手机号</text>
      <text class="form-value">{{userInfo.phone}}</text>
    </view>
    <view wx:else class="form-row" bindtap="goBindPhone">
      <text class="form-label">手机号</text>
      <text class="form-value form-link">立即绑定</text>
      <text class="form-arrow">›</text>
    </view>
    <view wx:if="{{userInfo.hasPassword}}" class="form-row" bindtap="goChangePassword">
      <text class="form-label">修改密码</text>
      <text class="form-arrow">›</text>
    </view>
    <view wx:else class="form-row" bindtap="goBindPhone">
      <text class="form-label">登录密码</text>
      <text class="form-value form-link">立即设置</text>
      <text class="form-arrow">›</text>
    </view>
  </view>

  <view class="save-area">
    <button class="btn-primary" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}">保存资料</button>
  </view>
</view>
