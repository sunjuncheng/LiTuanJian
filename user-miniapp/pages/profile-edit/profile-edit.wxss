.avatar-section {
  padding: 24rpx;
}

.avatar-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  padding: 34rpx 24rpx 28rpx;
  background: linear-gradient(180deg, #fffaf7 0%, #fff 100%);
  border-radius: 24rpx;
}

.avatar-wrap {
  position: relative;
  width: 148rpx;
  height: 148rpx;
}

.avatar-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 0;
  margin: 0;
  line-height: 1;
  text-align: center;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B35;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 53, 0.12);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 52rpx;
  height: 52rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}

.avatar-edit-icon {
  width: 26rpx;
  height: 26rpx;
}

.avatar-tip {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.avatar-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  text-align: center;
}

.avatar-subtip {
  margin-top: 10rpx;
  display: block;
  width: 100%;
  font-size: 22rpx;
  color: #FF6B35;
  line-height: 1.5;
  text-align: center;
}

.form-section {
  padding: 0;
  overflow: hidden;
  margin-top: 24rpx;
  border-radius: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  font-weight: 500;
}

.form-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.form-content-link {
  gap: 12rpx;
}

.form-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-value {
  font-size: 28rpx;
  color: #666;
  text-align: right;
}

.form-muted {
  color: #999;
}

.form-link {
  color: #FF6B35;
}

.form-arrow {
  font-size: 34rpx;
  color: #ccc;
  font-weight: 300;
  line-height: 1;
}

.save-area {
  margin-top: 60rpx;
  padding: 0 80rpx;
}
