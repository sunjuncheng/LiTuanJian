<view class="container">
  <view class="form-section card">
    <view class="form-row">
      <text class="form-label">原密码</text>
      <input class="form-input" password placeholder="请输入原密码" value="{{oldPassword}}" bindinput="onOldInput" />
    </view>
    <view class="form-row">
      <text class="form-label">新密码</text>
      <input class="form-input" password placeholder="至少6位" value="{{newPassword}}" bindinput="onNewInput" />
    </view>
    <view class="form-row">
      <text class="form-label">确认密码</text>
      <input class="form-input" password placeholder="再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
    </view>
  </view>
  <view class="save-area">
    <button class="btn-primary" bindtap="submit" loading="{{saving}}" disabled="{{saving}}">确认修改</button>
  </view>
</view>
