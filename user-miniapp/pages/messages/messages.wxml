<view class="container">
  <view class="chat-entry card live-entry" bindtap="goLiveList">
    <view class="chat-entry-main">
      <text class="chat-entry-title">直播中心</text>
      <text class="chat-entry-desc">查看当前直播、历史直播和观看入口</text>
    </view>
    <text class="chat-entry-arrow">进入 ></text>
  </view>

  <view class="chat-entry card" bindtap="goChatList">
    <view class="chat-entry-main">
      <text class="chat-entry-title">聊天会话</text>
      <text class="chat-entry-desc">查看你的队伍群聊和在线人数</text>
    </view>
    <text class="chat-entry-arrow">进入 ></text>
  </view>

  <view class="summary card">
    <text class="summary-title">未读提醒</text>
    <text class="summary-num">{{unreadCount}}</text>
  </view>

  <view class="message-list" wx:if="{{list.length}}">
    <view
      class="message-card card {{item.isRead ? 'read' : 'unread'}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-task-id="{{item.taskId}}"
      data-live-room-id="{{item.liveRoomId}}"
      data-is-read="{{item.isRead}}"
      bindtap="openMessage"
    >
      <view class="message-head">
        <view class="message-meta">
          <text class="message-type">{{item.typeText}}</text>
          <text class="message-title">{{item.title}}</text>
        </view>
        <text class="message-time">{{item.timeText}}</text>
      </view>
      <view class="message-content">{{item.content}}</view>
      <view class="message-footer">
        <text class="message-status {{item.isRead ? 'is-read' : 'is-unread'}}">{{item.isRead ? '已读' : '未读'}}</text>
        <text class="message-action" wx:if="{{item.taskId}}">查看任务详情 ></text>
        <text class="message-action" wx:elif="{{item.liveRoomId}}">进入直播间 ></text>
      </view>
    </view>
  </view>

  <view class="empty card" wx:else>
    <image class="messages-illustration" src="{{messagesIllustration}}" mode="widthFix"></image>
    <text class="empty-title">暂无消息提醒</text>
    <text class="empty-desc">任务提醒、直播提醒等消息，会在这里统一展示</text>
  </view>
</view>
