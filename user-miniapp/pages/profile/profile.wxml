<view class="container">
  <view class="profile-header card">
    <view wx:if="{{isLoggedIn}}" class="user-info" bindtap="goEditProfile">
      <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
      <view class="user-meta">
        <text class="nickname">{{userInfo.nickname || '微信用户'}}</text>
        <text class="user-phone">{{userInfo.phone || '未绑定手机号'}}</text>
      </view>
      <text class="edit-arrow">›</text>
    </view>
    <view wx:elif="{{showLoginForm}}" class="login-form">
      <image class="login-illustration" src="{{loginIllustration}}" mode="widthFix"></image>
      <button class="btn-primary wx-login-btn" bindtap="doWxLogin" loading="{{loading}}">
        微信一键登录
      </button>
      <view class="wx-login-tip">推荐使用微信快速登录，登录后可继续完善头像、昵称和手机号</view>

      <view class="divider-row">
        <view class="divider-line"></view>
        <text class="divider-text">备用方式</text>
        <view class="divider-line"></view>
      </view>

      <view class="form-tabs">
        <text class="tab {{mode === 'login' ? 'tab-active' : ''}}" bindtap="switchMode" data-mode="login">登录</text>
        <text class="tab {{mode === 'register' ? 'tab-active' : ''}}" bindtap="switchMode" data-mode="register">注册</text>
      </view>
      <view wx:if="{{mode === 'register'}}" class="form-item">
        <input class="form-input" placeholder="昵称（选填）" value="{{nickname}}" bindinput="onNicknameInput" />
      </view>
      <view class="form-item">
        <input class="form-input" type="number" placeholder="手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-item">
        <input class="form-input" password placeholder="密码" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <button wx:if="{{mode === 'login'}}" class="btn-primary" bindtap="doLogin" loading="{{loading}}">登录</button>
      <button wx:else class="btn-primary" bindtap="doRegister" loading="{{loading}}">注册</button>
      <view class="form-switch">
        <text wx:if="{{mode === 'login'}}" bindtap="switchMode">没有账号？去注册</text>
        <text wx:else bindtap="switchMode">已有账号？去登录</text>
      </view>
    </view>
    <view wx:else class="login-prompt" bindtap="toggleLoginForm">
      <image class="login-prompt-illustration" src="{{loginIllustration}}" mode="widthFix"></image>
      <text class="login-text">点击登录</text>
    </view>
  </view>

  <view class="menu-list card">
    <view class="menu-item menu-highlight" wx:if="{{isLoggedIn && !userInfo.hasPhone}}" bindtap="goBindPhone">
      <image class="menu-icon-image" src="{{icons.phone}}" mode="aspectFit"></image>
      <view class="menu-main">
        <text class="menu-text">绑定手机号</text>
        <text class="menu-desc">完善手机号和登录密码，后续登录与账号找回更方便</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMyTasks">
      <image class="menu-icon-image" src="{{icons.task}}" mode="aspectFit"></image>
      <text class="menu-text">我的任务</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goRecords">
      <image class="menu-icon-image" src="{{icons.records}}" mode="aspectFit"></image>
      <text class="menu-text">完成记录</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMessages">
      <image class="menu-icon-image" src="{{icons.message}}" mode="aspectFit"></image>
      <text class="menu-text">消息提醒</text>
      <view class="menu-extra" wx:if="{{unreadMessageCount > 0}}">
        <text class="menu-badge">{{unreadMessageCount > 99 ? '99+' : unreadMessageCount}}</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <image class="menu-icon-image" src="{{icons.settings}}" mode="aspectFit"></image>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-area">
    <button class="btn-outline" bindtap="logout">退出登录</button>
  </view>
</view>
