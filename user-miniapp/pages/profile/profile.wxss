.profile-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx 24rpx;
  flex-direction: column;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 0 10rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.edit-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

.login-prompt {
  padding: 20rpx 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
}

.login-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.login-form {
  width: 100%;
  padding: 0 10rpx;
}

.form-tabs {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
}

.tab {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 10rpx 0;
}

.tab-active {
  color: #fff;
  font-weight: 700;
  border-bottom: 3rpx solid #fff;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 48rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
  color: #fff;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.form-switch {
  text-align: center;
  margin-top: 24rpx;
}

.form-switch text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-list {
  margin-top: 20rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-area {
  margin-top: 40rpx;
  padding: 0 24rpx;
}
