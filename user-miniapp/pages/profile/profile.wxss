.profile-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx 24rpx;
  flex-direction: column;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.login-prompt {
  padding: 20rpx 60rpx;
  background: #4A90D9;
  border-radius: 48rpx;
}

.login-text {
  color: #fff;
  font-size: 28rpx;
}

.login-form {
  width: 100%;
  padding: 0 10rpx;
}

.form-tabs {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
}

.tab {
  font-size: 30rpx;
  color: #999;
  padding: 10rpx 0;
}

.tab-active {
  color: #4A90D9;
  font-weight: bold;
  border-bottom: 3rpx solid #4A90D9;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-primary {
  width: 100%;
  background: #4A90D9;
  color: #fff;
  font-size: 30rpx;
  border-radius: 8rpx;
  padding: 20rpx 0;
  line-height: 1.5;
  border: none;
}

.btn-primary::after {
  border: none;
}

.form-switch {
  text-align: center;
  margin-top: 24rpx;
}

.form-switch text {
  font-size: 26rpx;
  color: #4A90D9;
}

.menu-list {
  margin-top: 20rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-area {
  margin-top: 40rpx;
  padding: 0 24rpx;
}
