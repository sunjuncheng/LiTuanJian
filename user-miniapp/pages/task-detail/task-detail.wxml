<view class="container" wx:if="{{task}}">
  <view class="task-header card">
    <view class="task-name">{{task.name}}</view>
    <view class="task-tags">
      <text class="tag {{task.isEnded ? 'tag-gray' : 'tag-green'}}">{{task.statusText}}</text>
      <text class="tag tag-blue">{{acceptModeText}}</text>
      <text class="tag tag-orange">{{task.needReview ? '需人工审核' : '自动审核'}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">任务简介</view>
    <view class="section-content">{{task.description}}</view>
  </view>

  <view class="section card">
    <view class="section-title">活动须知</view>
    <view class="section-content">{{task.notice}}</view>
  </view>

  <view class="section card">
    <view class="section-title">启动点位</view>
    <view class="point-info">
      <text class="point-name">📍 {{task.startPoint.name}}</text>
      <text class="point-range">允许误差：{{task.startPoint.range}}米</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">打卡站点 ({{task.checkpoints.length}})</view>
    <view class="checkpoint-list">
      <view class="checkpoint-item" wx:for="{{task.checkpoints}}" wx:key="id">
        <view class="checkpoint-index">任务{{index + 1}}</view>
        <view class="checkpoint-name">{{item.name}}</view>
        <image class="reference-img" src="{{item.referenceImage}}" mode="aspectFill" wx:if="{{item.referenceImage}}"></image>
      </view>
    </view>
  </view>

  <view class="section card" wx:if="{{myProgress}}">
    <view class="section-title">我的进度</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{myProgress.percentage}}%"></view>
    </view>
    <view class="progress-text">完成度：{{myProgress.percentage}}%</view>
    <view class="progress-detail">
      <text>已通过 {{myProgress.passedCount}}</text>
      <text>待审核 {{myProgress.reviewingCount}}</text>
      <text>待打卡 {{myProgress.pendingCount}}</text>
    </view>
  </view>

  <view class="action-bar" wx:if="{{!myProgress}}">
    <block wx:if="{{task.canAccept}}">
      <button class="btn-primary" bindtap="acceptSolo" wx:if="{{task.acceptMode === 1 || task.acceptMode === 3}}">个人接单</button>
      <button class="btn-outline" bindtap="acceptTeam" wx:if="{{task.acceptMode === 2 || task.acceptMode === 3}}">队伍接单</button>
    </block>
    <view wx:else class="ended-tip">
      <text>{{task.isEnded ? '任务已结束' : '任务未发布'}}</text>
    </view>
  </view>

  <view class="action-bar" wx:if="{{myProgress && !myProgress.unlocked}}">
    <button class="btn-primary" bindtap="goStartPoint">前往启动点解锁</button>
  </view>

  <view class="action-bar" wx:if="{{myProgress && myProgress.unlocked}}">
    <button class="btn-primary" bindtap="goCheckin">开始打卡</button>
  </view>
</view>
