<view class="container" wx:if="{{task}}">
  <view class="task-header card">
    <view class="task-cover">
      <image class="cover-img" src="{{task.coverImage || defaultCover}}" mode="aspectFill"></image>
      <view class="cover-mask"></view>
      <view class="task-title-overlay">{{task.name}}</view>
    </view>
    <view class="task-tags">
      <text class="tag {{task.isEnded ? 'tag-gray' : 'tag-green'}}">{{task.statusText}}</text>
      <text class="tag tag-orange">{{task.acceptModeText}}</text>
      <text class="tag tag-blue">{{task.reviewModeText}}</text>
    </view>
  </view>

  <view class="task-info card">
    <view class="task-meta">
      <text>📍 {{task.checkpointCount}} 个打卡点</text>
      <text>👥 {{task.participantCount || 0}} 人参与</text>
      <text>⏰ {{task.deadlineText}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">任务说明</view>
    <view class="section-content">{{task.description || '暂未填写任务说明'}}</view>
  </view>

  <view class="section card" wx:if="{{task.notice}}">
    <view class="section-title">活动须知</view>
    <view class="section-content">{{task.notice}}</view>
  </view>

  <view class="section card">
    <view class="section-title">启动点信息</view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">点位名称</text>
        <text class="info-value">{{task.startPoint.name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">允许误差</text>
        <text class="info-value">{{task.startPoint.rangeText}}</text>
      </view>
      <view class="info-item full">
        <text class="info-label">坐标位置</text>
        <text class="info-value">{{task.startPoint.coordinateText}}</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">打卡点详情 ({{task.checkpoints.length}})</view>
    <view class="checkpoint-list" wx:if="{{task.checkpoints.length}}">
      <view class="checkpoint-card" wx:for="{{task.checkpoints}}" wx:key="id">
        <view class="checkpoint-head">
          <view class="checkpoint-badge">{{index + 1}}</view>
          <view class="checkpoint-head-main">
            <text class="checkpoint-name">{{item.name || item.sortLabel}}</text>
            <text class="checkpoint-subtitle">{{item.sortLabel}}</text>
          </view>
        </view>
        <view class="info-grid compact">
          <view class="info-item">
            <text class="info-label">打卡范围</text>
            <text class="info-value">{{item.rangeText}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">拍照要求</text>
            <text class="info-value">{{item.photoRuleText}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">备注规则</text>
            <text class="info-value">{{item.remarkRuleText}}</text>
          </view>
          <view class="info-item full">
            <text class="info-label">坐标位置</text>
            <text class="info-value">{{item.coordinateText}}</text>
          </view>
        </view>
        <view class="reference-block">
          <view class="reference-header">
            <text class="info-label">官方参照图</text>
            <text class="reference-tip">{{item.hasReferenceImage ? '已上传参照图' : '未上传参照图，显示默认占位图'}}</text>
          </view>
          <image class="reference-img" src="{{item.referenceImage || defaultImage}}" mode="aspectFill"></image>
        </view>
      </view>
    </view>
    <view class="empty-checkpoint" wx:else>暂未配置打卡点</view>
  </view>

  <view class="section card" wx:if="{{myProgress}}">
    <view class="section-title">我的进度</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{myProgress.percentage}}%"></view>
    </view>
    <view class="progress-text">完成度：{{myProgress.percentage}}%</view>
    <view class="progress-detail">
      <text class="pd-item passed">✓ 已通过 {{myProgress.passedCount}}</text>
      <text class="pd-item reviewing">⏳ 待审核 {{myProgress.reviewingCount}}</text>
      <text class="pd-item pending">○ 待打卡 {{myProgress.pendingCount}}</text>
    </view>
  </view>

  <view class="action-bar" wx:if="{{!myProgress}}">
    <block wx:if="{{task.canAccept}}">
      <button class="btn-primary" bindtap="acceptSolo" loading="{{accepting}}" disabled="{{accepting}}" wx:if="{{task.acceptMode === 1 || task.acceptMode === 3}}">个人接单</button>
      <button class="btn-outline" bindtap="acceptTeam" wx:if="{{task.acceptMode === 2 || task.acceptMode === 3}}">队伍接单</button>
    </block>
    <view wx:else class="ended-tip">
      <text>{{task.isEnded ? '任务已过时' : '任务未发布'}}</text>
    </view>
  </view>

  <view class="action-bar action-bar-vertical" wx:if="{{myProgress && !myProgress.unlocked && !task.isEnded}}">
    <view class="accepted-tip">✓ 已接单</view>
    <button class="btn-primary" bindtap="goStartPoint">前往启动点解锁</button>
    <button class="btn-outline giveup-btn" bindtap="giveUpTeamTask" wx:if="{{canGiveUp}}">放弃团队接单</button>
    <button class="btn-outline giveup-btn" bindtap="cancelTask" wx:if="{{canCancel}}">放弃任务</button>
  </view>

  <view class="action-bar action-bar-vertical" wx:if="{{myProgress && myProgress.unlocked && !task.isEnded}}">
    <view class="accepted-tip">✓ 已接单</view>
    <button class="btn-primary" bindtap="goCheckin">开始打卡</button>
  </view>

  <view class="action-bar action-bar-vertical" wx:if="{{myProgress && task.isEnded}}">
    <view class="ended-tip">任务已过时，无法继续操作</view>
  </view>
</view>
