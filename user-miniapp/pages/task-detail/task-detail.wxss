.task-header {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.task-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0.7) 100%);
}

.task-title-overlay {
  position: absolute;
  bottom: 30rpx;
  left: 28rpx;
  right: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

.task-tags {
  display: flex;
  gap: 12rpx;
  padding: 24rpx;
  flex-wrap: wrap;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

.point-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.point-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.point-range {
  font-size: 24rpx;
  color: #999;
}

.checkpoint-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkpoint-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #F8F9FB;
  border-radius: 16rpx;
}

.cp-index {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cp-num {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.cp-content {
  flex: 1;
  min-width: 0;
}

.cp-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.cp-location {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.reference-img {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
}

.progress-bar {
  width: 100%;
  height: 18rpx;
  background: #f0f0f0;
  border-radius: 9rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF4757);
  border-radius: 9rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.progress-detail {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.pd-item {
  font-weight: 500;
}

.pd-item.passed {
  color: #6BCB77;
}

.pd-item.reviewing {
  color: #FFB800;
}

.pd-item.pending {
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-bar button {
  flex: 1;
}

.ended-tip {
  width: 100%;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #999;
}

.accepted-tip {
  width: 100%;
  text-align: center;
  padding: 10rpx 0 16rpx;
  font-size: 26rpx;
  color: #52c41a;
  font-weight: 600;
}

.action-bar-vertical {
  flex-direction: column;
  gap: 12rpx;
}

.action-bar-vertical button {
  width: 100%;
}

.giveup-btn {
  color: #FF4757 !important;
  border-color: #FF4757 !important;
}
