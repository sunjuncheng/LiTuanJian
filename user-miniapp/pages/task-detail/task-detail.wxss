.task-header {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.task-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0.7) 100%);
}

.task-title-overlay {
  position: absolute;
  bottom: 30rpx;
  left: 28rpx;
  right: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

.task-tags {
  display: flex;
  gap: 12rpx;
  padding: 24rpx;
  flex-wrap: wrap;
}

.task-info {
  margin-bottom: 24rpx;
}

.task-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 0;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-grid.compact {
  margin-top: 16rpx;
}

.info-item {
  width: calc(50% - 8rpx);
  background: #FFF7F3;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.info-item.full {
  width: 100%;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-all;
}

.checkpoint-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkpoint-card {
  padding: 24rpx;
  background: linear-gradient(180deg, #FFFDFC 0%, #FFF6F2 100%);
  border-radius: 20rpx;
  border: 1rpx solid #FFE5DA;
}

.checkpoint-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.checkpoint-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkpoint-head-main {
  flex: 1;
  min-width: 0;
}

.checkpoint-name {
  display: block;
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
}

.checkpoint-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.reference-block {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #FFE4D7;
}

.reference-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.reference-tip {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

.reference-img {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: #F5F6F8;
}

.empty-checkpoint {
  padding: 32rpx 0 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.progress-bar {
  width: 100%;
  height: 18rpx;
  background: #f0f0f0;
  border-radius: 9rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF4757);
  border-radius: 9rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.progress-detail {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.pd-item {
  font-weight: 500;
}

.pd-item.passed {
  color: #6BCB77;
}

.pd-item.reviewing {
  color: #FFB800;
}

.pd-item.pending {
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-bar button {
  flex: 1;
}

.ended-tip {
  width: 100%;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #999;
}

.accepted-tip {
  width: 100%;
  text-align: center;
  padding: 10rpx 0 16rpx;
  font-size: 26rpx;
  color: #52c41a;
  font-weight: 600;
}

.action-bar-vertical {
  flex-direction: column;
  gap: 12rpx;
}

.action-bar-vertical button {
  width: 100%;
}

.giveup-btn {
  color: #FF4757 !important;
  border-color: #FF4757 !important;
}
