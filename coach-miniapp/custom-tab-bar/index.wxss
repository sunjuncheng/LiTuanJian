.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 40rpx;
  transition: transform 0.2s;
}

.tab-item.active .tab-icon {
  transform: scale(1.15);
}

.tab-text {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #FF6B35;
  font-weight: 600;
}
