.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 10rpx 0 18rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.create-btn {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  line-height: 1.5;
  box-shadow: 0 6rpx 16rpx rgba(255, 71, 87, 0.3);
}

.create-btn::after {
  border: none;
}

.task-card {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.task-cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.06) 35%, rgba(0, 0, 0, 0.66) 100%);
}

.task-name-overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.28);
}

.task-body {
  padding: 24rpx;
}

.mode-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.task-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #888;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-link {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 500;
}

.action-link.danger {
  color: #FF4757;
}
