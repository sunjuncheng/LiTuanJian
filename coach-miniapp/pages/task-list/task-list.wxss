.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.create-btn {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  line-height: 1.5;
  box-shadow: 0 6rpx 16rpx rgba(255, 71, 87, 0.3);
}

.create-btn::after {
  border: none;
}

.task-card {
  margin-bottom: 24rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  flex: 1;
  margin-right: 16rpx;
}

.task-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #888;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-link {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 500;
}

.action-link.danger {
  color: #FF4757;
}
