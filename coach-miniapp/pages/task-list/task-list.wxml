<view class="container">
  <view class="page-header">
    <view>
      <text class="page-title">教练任务中心</text>
      <text class="page-subtitle">创建、发布并跟进每一场团建打卡任务</text>
    </view>
    <button class="create-btn" bindtap="goCreate">+ 新建</button>
  </view>

  <view wx:if="{{taskList.length === 0 && !loading}}" class="empty">
    <image class="empty-icon-image" src="{{icons.task}}" mode="aspectFit"></image>
    <text>暂无任务，点击右上角新建</text>
  </view>

  <view class="task-list">
    <view
      class="task-card card"
      wx:for="{{taskList}}"
      wx:key="id"
    >
      <view class="task-cover" data-id="{{item.id}}" bindtap="goDetail">
        <image class="cover-img" src="{{item.coverImage || defaultCover}}" mode="aspectFill"></image>
        <view class="cover-mask"></view>
        <view class="task-name-overlay">{{item.name}}</view>
      </view>
      <view class="task-body" data-id="{{item.id}}" bindtap="goDetail">
        <view class="mode-tags">
          <text class="tag {{item.acceptMode === 2 ? 'tag-blue' : 'tag-orange'}}">{{item.acceptMode === 2 ? '仅团队接单' : '仅个人接单'}}</text>
          <text class="tag {{item.status === 'published' ? 'tag-green' : 'tag-gray'}}">
            {{item.status === 'published' ? '已发布' : '草稿'}}
          </text>
        </view>
        <view class="task-meta">
          <view class="meta-item">
            <image class="meta-icon" src="{{icons.location}}" mode="aspectFit"></image>
            <text>{{item.checkpointCount}} 个打卡点</text>
          </view>
          <view class="meta-item">
            <image class="meta-icon" src="{{icons.team}}" mode="aspectFit"></image>
            <text>{{item.participantCount}} 人参与</text>
          </view>
        </view>
        <view class="task-actions">
          <view class="action-link" data-id="{{item.id}}" bindtap="goDetail">查看详情</view>
          <view class="action-link danger" data-id="{{item.id}}" bindtap="deleteTask">删除</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
