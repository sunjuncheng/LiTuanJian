<view class="container">
  <view class="page-header">
    <text class="page-title">任务管理</text>
    <button class="create-btn" bindtap="goCreate">+ 新建任务</button>
  </view>

  <view wx:if="{{taskList.length === 0}}" class="empty">
    <text>暂无任务，点击右上角新建</text>
  </view>

  <view class="task-list">
    <view
      class="task-card card"
      wx:for="{{taskList}}"
      wx:key="id"
    >
      <view class="task-header" data-id="{{item.id}}" bindtap="goDetail">
        <text class="task-name">{{item.name}}</text>
        <text class="tag {{item.status === 'published' ? 'tag-green' : 'tag-gray'}}">
          {{item.status === 'published' ? '已发布' : '草稿'}}
        </text>
      </view>
      <view class="task-meta" data-id="{{item.id}}" bindtap="goDetail">
        <text>📍 {{item.checkpointCount}} 个打卡点</text>
        <text>👥 {{item.participantCount}} 人参与</text>
      </view>
      <view class="task-actions">
        <button class="btn-outline btn-sm" data-id="{{item.id}}" bindtap="deleteTask">删除</button>
      </view>
    </view>
  </view>
</view>
