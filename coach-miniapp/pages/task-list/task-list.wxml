<view class="container">
  <view class="page-header">
    <view>
      <text class="page-title">🏃 任务管理</text>
      <text class="page-subtitle">创建并管理团建打卡任务</text>
    </view>
    <button class="create-btn" bindtap="goCreate">+ 新建</button>
  </view>

  <view wx:if="{{taskList.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">📋</view>
    <text>暂无任务，点击右上角新建</text>
  </view>

  <view class="task-list">
    <view
      class="task-card card"
      wx:for="{{taskList}}"
      wx:key="id"
    >
      <view class="task-header" data-id="{{item.id}}" bindtap="goDetail">
        <text class="task-name">{{item.name}}</text>
        <text class="tag {{item.status === 'published' ? 'tag-green' : 'tag-gray'}}">
          {{item.status === 'published' ? '已发布' : '草稿'}}
        </text>
      </view>
      <view class="task-meta" data-id="{{item.id}}" bindtap="goDetail">
        <text class="meta-item">📍 {{item.checkpointCount}} 个打卡点</text>
        <text class="meta-item">👥 {{item.participantCount}} 人参与</text>
      </view>
      <view class="task-actions">
        <view class="action-link" data-id="{{item.id}}" bindtap="goDetail">查看详情</view>
        <view class="action-link danger" data-id="{{item.id}}" bindtap="deleteTask">删除</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
