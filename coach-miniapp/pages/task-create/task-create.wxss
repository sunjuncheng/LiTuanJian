.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 30rpx;
}

.step {
  font-size: 22rpx;
  color: #999;
}

.step.active {
  color: #2c3e50;
  font-weight: bold;
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  background: #e0e0e0;
  margin: 0 16rpx;
}

.step-line.active {
  background: #2c3e50;
}

.step-content {
  margin-bottom: 30rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.loc-info {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #52c41a;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
}

.checkpoint-card {
  margin-bottom: 20rpx;
}

.cp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cp-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.remove-btn {
  font-size: 26rpx;
  color: #f5222d;
}

.img-upload {
  width: 100%;
  height: 200rpx;
  background: #f8f9fa;
  border: 2rpx dashed #d0d0d0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 26rpx;
}

.ref-img {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

.add-btn {
  margin: 20rpx 0;
}

.step-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.step-btns button {
  flex: 1;
}

.final-btns {
  flex-wrap: wrap;
}

.final-btns button {
  flex: 1;
  min-width: 200rpx;
}
