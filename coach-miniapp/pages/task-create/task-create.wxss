.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 36rpx;
}

.step {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.step.active {
  color: #FF6B35;
  font-weight: bold;
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  background: #E8E8E8;
  margin: 0 16rpx;
}

.step-line.active {
  background: #FF6B35;
}

.step-content {
  margin-bottom: 30rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  color: #333;
}

.loc-info {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6BCB77;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
}

.checkpoint-card {
  margin-bottom: 24rpx;
  border: 2rpx solid #FFF0EB;
}

.cp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.cp-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF6B35;
}

.remove-btn {
  font-size: 26rpx;
  color: #FF4757;
  font-weight: 500;
}

.img-upload {
  width: 100%;
  height: 220rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.img-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.58) 100%);
}

.img-upload-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

.ref-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.add-btn {
  margin: 24rpx 0;
}

.step-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.step-btns button {
  flex: 1;
}

.final-btns {
  flex-wrap: wrap;
}

.final-btns button {
  flex: 1;
  min-width: 200rpx;
}

.cover-upload {
  width: 100%;
  height: 280rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #fff;
  gap: 12rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 20%, rgba(0, 0, 0, 0.62) 100%);
}

.cover-icon {
  font-size: 30rpx;
  font-weight: 700;
}

.cover-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}
