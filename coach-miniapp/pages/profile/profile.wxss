.profile-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx 28rpx;
  flex-direction: column;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.user-info {
  width: 100%;
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.user-phone {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.role-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border-radius: 20rpx;
  font-size: 22rpx;
  width: fit-content;
}

.login-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.login-tip {
  font-size: 38rpx;
  color: #fff;
  margin-bottom: 34rpx;
  font-weight: bold;
  text-align: center;
}

.login-form {
  width: 100%;
  display: block;
}

.login-form .form-item {
  margin-bottom: 24rpx;
  width: 100%;
}

.login-form .form-input {
  width: 100% !important;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 48rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  height: 84rpx;
  line-height: 84rpx;
  color: #fff;
}

.login-form .form-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.login-btn {
  width: 100%;
  margin-top: 20rpx;
  background: #fff;
  color: #FF6B35;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border: none;
}

.login-btn::after {
  border: none;
}

.menu-list {
  margin-top: 0;
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-area {
  margin-top: 40rpx;
  padding: 0;
}
