<view class="container">
  <view class="profile-header card">
    <view wx:if="{{isLoggedIn}}" class="user-info">
      <image class="avatar" src="{{coachInfo.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
      <view class="user-meta">
        <text class="nickname">{{coachInfo.name}}</text>
        <text class="user-phone">{{coachInfo.phone || '已绑定教练账号'}}</text>
        <text class="role-tag">教练</text>
      </view>
    </view>
    <view wx:else class="login-area">
      <text class="login-tip">教练登录</text>
      <view class="login-form">
        <view class="form-item">
          <input class="form-input" type="number" placeholder="手机号" value="{{phone}}" bindinput="onPhoneInput" />
        </view>
        <view class="form-item">
          <input class="form-input" password placeholder="密码" value="{{password}}" bindinput="onPasswordInput" />
        </view>
        <button class="login-btn" bindtap="doLogin" loading="{{loading}}">登录</button>
      </view>
    </view>
  </view>

  <view class="menu-list card">
    <view class="menu-item" bindtap="goTaskList">
      <image class="menu-icon-image" src="{{icons.task}}" mode="aspectFit"></image>
      <text class="menu-text">任务概览</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goReviewList">
      <image class="menu-icon-image" src="{{icons.review}}" mode="aspectFit"></image>
      <text class="menu-text">审核记录</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="showSettingsTip">
      <image class="menu-icon-image" src="{{icons.settings}}" mode="aspectFit"></image>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-area">
    <button class="btn-outline" bindtap="logout">退出登录</button>
  </view>
</view>
