<view class="container" wx:if="{{task}}">
  <view class="task-header card">
    <view class="task-cover">
      <image class="cover-img" src="{{task.coverImage || defaultCover}}" mode="aspectFill"></image>
      <view class="cover-mask"></view>
      <view class="task-title-overlay">{{task.name}}</view>
    </view>
    <view class="task-tags">
      <text class="tag {{task.acceptMode === 2 ? 'tag-blue' : 'tag-orange'}}">{{task.acceptModeText}}</text>
      <text class="tag {{task.isEnded ? 'tag-gray' : (task.status === 'published' ? 'tag-green' : 'tag-gray')}}">{{task.statusText}}</text>
      <text class="tag tag-blue">{{task.reviewModeText}}</text>
    </view>
  </view>

  <view class="task-info card">
    <view class="task-meta">
      <view class="meta-item">
        <image class="meta-icon" src="{{icons.location}}" mode="aspectFit"></image>
        <text>{{task.checkpointCount}} 个打卡点</text>
      </view>
      <view class="meta-item">
        <image class="meta-icon" src="{{icons.team}}" mode="aspectFit"></image>
        <text>{{participants.length + teams.length}} 个参与</text>
      </view>
      <view class="meta-item">
        <image class="meta-icon" src="{{icons.clock}}" mode="aspectFit"></image>
        <text>{{task.deadlineText}}</text>
      </view>
    </view>
    <view class="overall-progress">
      <text>整体完成度</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{task.completionRate}}%"></view>
      </view>
      <text class="progress-num">{{task.completionRate}}%</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">任务说明</view>
    <view class="section-content">{{task.description || '暂未填写任务说明'}}</view>
  </view>

  <view class="section card" wx:if="{{task.notice}}">
    <view class="section-title">活动须知</view>
    <view class="section-content">{{task.notice}}</view>
  </view>

  <view class="section card">
    <view class="section-title">启动点信息</view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">点位名称</text>
        <text class="info-value">{{task.startPoint.name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">允许误差</text>
        <text class="info-value">{{task.startPoint.rangeText}}</text>
      </view>
      <view class="info-item full">
        <text class="info-label">坐标位置</text>
        <text class="info-value">{{task.startPoint.coordinateText}}</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">打卡点详情 ({{task.checkpoints.length}})</view>
    <view class="checkpoint-list" wx:if="{{task.checkpoints.length}}">
      <view class="checkpoint-card" wx:for="{{task.checkpoints}}" wx:key="id">
        <view class="checkpoint-head">
          <view class="checkpoint-badge">{{index + 1}}</view>
          <view class="checkpoint-head-main">
            <text class="checkpoint-name">{{item.name || item.sortLabel}}</text>
            <text class="checkpoint-subtitle">{{item.sortLabel}}</text>
          </view>
        </view>
        <view class="info-grid compact">
          <view class="info-item">
            <text class="info-label">打卡范围</text>
            <text class="info-value">{{item.rangeText}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">拍照要求</text>
            <text class="info-value">{{item.photoRuleText}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">备注规则</text>
            <text class="info-value">{{item.remarkRuleText}}</text>
          </view>
          <view class="info-item full">
            <text class="info-label">坐标位置</text>
            <text class="info-value">{{item.coordinateText}}</text>
          </view>
        </view>
        <view class="reference-block">
          <view class="reference-header">
            <text class="info-label">官方参照图</text>
            <text class="reference-tip">{{item.hasReferenceImage ? '已上传参照图' : '未上传参照图，显示默认占位图'}}</text>
          </view>
          <image class="reference-img" src="{{item.referenceImage || defaultImage}}" mode="aspectFill"></image>
        </view>
      </view>
    </view>
    <view class="empty-checkpoint" wx:else>暂未配置打卡点</view>
  </view>

  <view class="tabs">
    <view class="tab {{activeTab === 'solo' ? 'active' : ''}}" data-tab="solo" bindtap="switchTab">单人 ({{participants.length}})</view>
    <view class="tab {{activeTab === 'team' ? 'active' : ''}}" data-tab="team" bindtap="switchTab">队伍 ({{teams.length}})</view>
  </view>

  <view wx:if="{{activeTab === 'solo'}}" class="participant-list">
    <view class="participant-card card" wx:for="{{participants}}" wx:key="id">
      <view class="p-header">
        <image class="avatar" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
        <view class="p-info">
          <text class="p-name">{{item.nickname}}</text>
          <text class="tag {{item.status === 'completed' ? 'tag-green' : item.status === 'in_progress' ? 'tag-blue' : 'tag-gray'}}">
            {{item.statusText}}
          </text>
        </view>
        <view class="p-progress">
          <text class="p-progress-num">{{item.completionRate}}%</text>
        </view>
      </view>
      <view class="p-actions">
        <button class="mini-btn" data-id="{{item.id}}" bindtap="goReview">审核</button>
        <button class="mini-btn outline" data-id="{{item.id}}" bindtap="remind">提醒</button>
        <button class="mini-btn outline" data-id="{{item.id}}" bindtap="manualUnlock" wx:if="{{!item.unlocked}}">解锁</button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'team'}}" class="participant-list">
    <view class="participant-card card" wx:for="{{teams}}" wx:key="id">
      <view class="p-header">
        <image class="team-avatar-image" src="{{icons.team}}" mode="aspectFit"></image>
        <view class="p-info">
          <text class="p-name">{{item.name}}</text>
          <text class="text-muted">队长：{{item.leaderName}} · {{item.memberCount}}人</text>
        </view>
        <view class="p-progress">
          <text class="p-progress-num">{{item.completionRate}}%</text>
        </view>
      </view>
      <view class="p-actions">
        <button class="mini-btn" data-id="{{item.id}}" bindtap="goReview">审核</button>
        <button class="mini-btn outline" data-id="{{item.id}}" bindtap="remind">提醒</button>
      </view>
    </view>
  </view>
</view>
