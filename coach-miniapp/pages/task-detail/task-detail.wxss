.task-header {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.task-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08) 28%, rgba(0, 0, 0, 0.72) 100%);
}

.task-title-overlay {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.34);
}

.task-tags {
  display: flex;
  gap: 12rpx;
  padding: 24rpx;
  flex-wrap: wrap;
}

.task-info {
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.section-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #666;
}

.task-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.overall-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #F0F0F0;
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF4757 100%);
  border-radius: 7rpx;
}

.progress-num {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: bold;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-grid.compact {
  margin-top: 16rpx;
}

.info-item {
  width: calc(50% - 8rpx);
  background: #FFF7F3;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.info-item.full {
  width: 100%;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-all;
}

.checkpoint-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkpoint-card {
  padding: 24rpx;
  background: linear-gradient(180deg, #FFFDFC 0%, #FFF6F2 100%);
  border-radius: 20rpx;
  border: 1rpx solid #FFE5DA;
}

.checkpoint-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.checkpoint-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkpoint-head-main {
  flex: 1;
  min-width: 0;
}

.checkpoint-name {
  display: block;
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
}

.checkpoint-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.reference-block {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #FFE4D7;
}

.reference-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.reference-tip {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

.reference-img {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: #F5F6F8;
}

.empty-checkpoint {
  padding: 32rpx 0 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  font-weight: 500;
}

.tab.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
}

.participant-card {
  margin-bottom: 20rpx;
}

.p-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F5F6F8;
  border: 2rpx solid #FFF0EB;
}

.team-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE4D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.p-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.p-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: bold;
}

.p-progress {
  text-align: right;
  min-width: 100rpx;
}

.p-progress-num {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

.p-actions {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 18rpx;
}

.mini-btn {
  flex: 1;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 10rpx;
  line-height: 1.5;
  font-weight: 500;
}

.mini-btn::after {
  border: none;
}

.mini-btn.outline {
  background: #fff;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}
