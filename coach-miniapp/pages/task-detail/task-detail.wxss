.task-info {
  margin-bottom: 24rpx;
}

.task-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 14rpx;
}

.task-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.overall-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #F0F0F0;
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF4757 100%);
  border-radius: 7rpx;
}

.progress-num {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: bold;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  font-weight: 500;
}

.tab.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
}

.participant-card {
  margin-bottom: 20rpx;
}

.p-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F5F6F8;
}

.team-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE4D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.p-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.p-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: bold;
}

.p-progress {
  text-align: right;
}

.p-progress-num {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

.p-actions {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 18rpx;
}

.mini-btn {
  flex: 1;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 10rpx;
  line-height: 1.5;
  font-weight: 500;
}

.mini-btn::after {
  border: none;
}

.mini-btn.outline {
  background: #fff;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}
