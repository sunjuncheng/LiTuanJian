.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  font-weight: 500;
}

.tab.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
}

.message-card {
  margin-bottom: 24rpx;
}

.message-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F5F6F8;
  margin-right: 20rpx;
  border: 2rpx solid #FFF0EB;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.message-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  flex: 1;
}

.message-subtitle {
  display: block;
  font-size: 24rpx;
  color: #888;
}

.message-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.meta-line {
  display: flex;
  gap: 20rpx;
}

.meta-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.meta-value {
  flex: 1;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.reject-text {
  color: #FF4757;
}

.task-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.review-link {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
}
