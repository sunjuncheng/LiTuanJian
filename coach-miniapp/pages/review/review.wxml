<view class="container">
  <view class="page-header">
    <text class="page-title">✅ 打卡审核</text>
    <text class="page-subtitle">审核用户打卡照片</text>
  </view>

  <view wx:if="{{taskList.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">📋</view>
    <text>暂无待审核任务</text>
  </view>

  <view wx:for="{{taskList}}" wx:key="id" class="task-card card" bindtap="goDetail" data-id="{{item.id}}">
    <view class="task-header">
      <text class="task-title">{{item.name}}</text>
      <text class="tag {{item.status === 'published' ? 'tag-green' : 'tag-gray'}}">
        {{item.status === 'published' ? '已发布' : '草稿'}}
      </text>
    </view>
    <text class="task-desc">{{item.description}}</text>
    <view class="task-meta">
      <text class="meta-item">📍 {{item.checkpointCount || 0}} 个打卡点</text>
      <text class="meta-item">👥 {{item.participantCount || 0}} 人参与</text>
    </view>
    <view class="task-footer">
      <text class="review-link">查看并审核 ›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
