.checkpoint-tabs {
  background: #fff;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.06);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F0F0F0;
  color: #999;
  font-size: 28rpx;
  font-weight: bold;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF4757 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.3);
}

.tab-item.passed {
  background: #6BCB77;
  color: #fff;
}

.tab-item.rejected {
  background: #FF4757;
  color: #fff;
}

.tab-item.reviewing {
  background: #FFB800;
  color: #fff;
}

.cp-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cp-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.compare-area {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.img-card {
  flex: 1;
  padding: 20rpx;
}

.img-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  text-align: center;
}

.review-img {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

.no-photo {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F6F8;
  border-radius: 12rpx;
  color: #999;
  font-size: 26rpx;
}

.location-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.location-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.location-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.reject-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.reject-label {
  font-size: 26rpx;
  color: #FF4757;
  font-weight: bold;
}

.reject-text {
  font-size: 28rpx;
  color: #666;
}

.review-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.review-actions .btn-success,
.review-actions .btn-danger {
  flex: 1;
}

.reject-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btns .btn-outline,
.modal-btns .btn-danger {
  flex: 1;
}
