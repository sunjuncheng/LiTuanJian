.checkpoint-tabs {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  color: #999;
  font-size: 28rpx;
  font-weight: bold;
}

.tab-item.active {
  background: #2c3e50;
  color: #fff;
}

.tab-item.passed {
  background: #52c41a;
  color: #fff;
}

.tab-item.rejected {
  background: #f5222d;
  color: #fff;
}

.tab-item.reviewing {
  background: #fa8c16;
  color: #fff;
}

.cp-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cp-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.compare-area {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.img-card {
  flex: 1;
  padding: 20rpx;
}

.img-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  text-align: center;
}

.review-img {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
}

.no-photo {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  color: #999;
  font-size: 26rpx;
}

.location-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reject-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reject-label {
  font-size: 26rpx;
  color: #f5222d;
  font-weight: bold;
}

.reject-text {
  font-size: 28rpx;
  color: #666;
}

.review-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.review-actions .btn-success,
.review-actions .btn-danger {
  flex: 1;
}

.reject-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.modal-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btns .btn-outline,
.modal-btns .btn-danger {
  flex: 1;
}
